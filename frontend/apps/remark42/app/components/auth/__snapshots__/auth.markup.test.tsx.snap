exports[`the sign-in form draws the markup of the preact component it replaces through the email steps: a token that does not parse 1`] = `"<div class="auth root"><button class="auth-button button selected">Sign in<div class="suffix"><svg width="14" height="14" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 11.5L14.5 19L22 11" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></button><div class="auth-dropdown dropdown"><form class="auth-form form"><div class="auth-row row"><div class="backButton"><button class="auth-back-button button transparent xs"><svg class="backButtonArrow" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.75 3L5 7.25L9 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back</button></div><button class="auth-close-button closeButton" title="Close sign-in dropdown"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 2L12 12M12 2L2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div><div class="auth-row row"><textarea name="token" class="auth-token-textarea input textarea" placeholder="Paste the token from the email, or click the link in it" dir="auto" style="height: 0px;"></textarea></div><div class="auth-error error">Token is invalid</div><button class="auth-submit button" type="submit">Confirm</button></form></div></div>"`;

exports[`the sign-in form draws the markup of the preact component it replaces through the email steps: back on the email step 1`] = `"<div class="auth root"><button class="auth-button button selected">Sign in<div class="suffix"><svg width="14" height="14" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 11.5L14.5 19L22 11" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></button><div class="auth-dropdown dropdown"><form class="auth-form form"><h5 class="auth-form-title title">email</h5><div class="auth-row row"><input class="auth-input-username input" type="text" required="" name="username" pattern="\\s*[\\p{L}\\d_\\-][\\p{L}\\d _\\-]{1,62}[\\p{L}\\d_\\-]\\s*" title="Name must be 3 to 64 characters long and may only contain letters, numbers, underscores, hyphens and spaces" placeholder="Name" dir="auto"></div><div class="auth-row row"><input class="auth-input-email input" type="email" required="" name="email" placeholder="Email address" dir="auto"></div><button class="auth-submit button" type="submit">Confirm</button></form></div></div>"`;

exports[`the sign-in form draws the markup of the preact component it replaces through the email steps: sending the email 1`] = `"<div class="auth root"><button class="auth-button button selected">Sign in<div class="suffix"><svg width="14" height="14" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 11.5L14.5 19L22 11" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></button><div class="auth-dropdown dropdown"><form class="auth-form form"><h5 class="auth-form-title title">email</h5><div class="auth-row row"><input class="auth-input-username input" type="text" required="" name="username" pattern="\\s*[\\p{L}\\d_\\-][\\p{L}\\d _\\-]{1,62}[\\p{L}\\d_\\-]\\s*" title="Name must be 3 to 64 characters long and may only contain letters, numbers, underscores, hyphens and spaces" placeholder="Name" dir="auto" disabled=""></div><div class="auth-row row"><input class="auth-input-email input" type="email" required="" name="email" placeholder="Email address" dir="auto" disabled=""></div><button class="auth-submit button" type="submit" disabled=""><div class="spinner root" role="presentation" aria-label="Loading..." data-testid="spinner"></div></button></form></div></div>"`;

