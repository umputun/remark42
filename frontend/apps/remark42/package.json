{
  "name": "@remark42/app",
  "version": "0.16.0",
  "license": "MIT",
  "scripts": {
    "dev": "go -C ../../build run . -serve",
    "dev:demo": "go -C ../../build run . -serve -api-base=https://demo.remark42.com",
    "build": "go -C ../../build run .",
    "lint": "pnpm run \"/^lint:/\"",
    "lint:styles": "stylelint \"app/**/*.css\"",
    "lint:scripts": "eslint --max-warnings=0 \"**/*.{ts?(x),?(c)js,mjs}\"",
    "test": "jest",
    "test:unit": "node --test \"app/**/*.unit.test.ts\" \"tasks/**/*.unit.test.ts\"",
    "coverage": "jest --coverage",
    "format": "prettier --write \"./**/*.{js,mjs,ts,tsx,css,html}\"",
    "size-check": "pnpm build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./tasks/check-size.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "translation-check": "pnpm translation:extract && pnpm translation:check",
    "translation:extract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./tasks/extract-messages.ts",
    "translation:generate": "node ./tasks/generateDictionary.js",
    "translation:check": "node ./tasks/checkTranslation.js"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "3.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-jest": "^30.4.1",
    "confusing-browser-globals": "^1.0.11",
    "eslint": "^9.39.1",
    "eslint-config-preact": "^2.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fetch-mock": "^4.2.0",
    "jest-localstorage-mock": "^2.4.26",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "json5@<1.0.2": ">=1.0.2",
      "json5@>=2.0.0 <2.2.2": ">=2.2.2",
      "tough-cookie@<4.1.3": ">=4.1.3",
      "micromatch@<4.0.8": ">=4.0.8",
      "word-wrap@<1.2.4": ">=1.2.4",
      "@babel/runtime@<7.26.10": ">=7.26.10 <8.0.0",
      "@babel/helpers@<7.26.10": ">=7.26.10 <8.0.0",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "nanoid@>=4.0.0 <5.0.9": ">=5.0.9",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0 <11.0.0",
      "semver@>=2.0.0-alpha <5.7.2": ">=5.7.2",
      "semver@>=7.0.0 <7.5.2": ">=7.5.2",
      "semver@>=6.0.0 <6.3.1": ">=6.3.1",
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "@babel/traverse@<7.23.2": ">=7.23.2 <8.0.0",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": ">=7.29.4 <8.0.0",
      "@babel/core@<=7.29.0": ">=7.29.6 <8.0.0",
      "js-yaml@>=3.0.0 <4.0.0": ">=3.15.1 <4.0.0",
      "js-yaml@>=4.0.0 <5.0.0": ">=5.2.2 <6.0.0",
      "minimatch@>=3.0.0 <4.0.0": ">=3.1.3 <4.0.0",
      "minimatch@>=9.0.0 <10.0.0": ">=9.0.7 <10.0.0",
      "ajv@>=8.0.0 <9.0.0": ">=8.18.0 <9.0.0",
      "ws@>=7.0.0 <8.0.0": ">=7.5.11 <8.0.0",
      "ws@>=8.0.0 <9.0.0": ">=8.21.0 <9.0.0",
      "brace-expansion@>=1.0.0 <2.0.0": ">=1.1.18 <2.0.0",
      "brace-expansion@>=2.0.0 <3.0.0": ">=2.0.2 <3.0.0",
      "brace-expansion@>=4.0.0 <6.0.0": ">=5.0.9 <6.0.0",
      "fast-uri": ">=4.1.4 <5.0.0",
      "nanoid@>=3.0.0 <4.0.0": ">=3.3.18 <4.0.0",
      "postcss@<8.5.23": ">=8.5.23 <9.0.0",
      "preact": "10.29.8",
      "@babel/core": "^8.0.1",
      "eslint-config-preact>@babel/core": "^7.29.7"
    }
  }
}
