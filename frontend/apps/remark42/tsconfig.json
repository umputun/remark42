{
  "compilerOptions": {
    "incremental": true,
    "target": "es6",
    "module": "esnext",
    "lib": [
      "es2019",
      "dom"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": "app",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "paths": {
      "react": [
        "../node_modules/preact/compat"
      ],
      "react-dom": [
        "../node_modules/preact/compat"
      ],
      "preact": [
        "../node_modules/preact"
      ],
      "preact/*": [
        "../node_modules/preact/*"
      ]
    },
    "jsxImportSource": "preact"
  },
  "include": [
    "app/typings",
    "app/**/*.tsx",
    "app/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
