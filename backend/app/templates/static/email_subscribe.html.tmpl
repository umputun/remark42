<!DOCTYPE html>
<html>
<head>
		<meta name="viewport" content="width=device-width"/>
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
</head>
<body>
<div style="text-align: center; font-family: Arial, sans-serif; font-size: 18px;">
		<h1 style="position: relative; color: #4fbbd6; margin-top: 0.2em;">Remark42</h1>
	{{- if .Confirmed}}
	<p style="position: relative; max-width: 20em; margin: 0 auto 1em auto; line-height: 1.4em;">Successfully subscribed to email notifications on site <b>{{.Site}}</b></p>
	<p style="position: relative; max-width: 20em; margin: 0 auto 1em auto; line-height: 1.4em; font-size: 0.8em; opacity: 0.8;">You can return to the comments now.</p>
	{{- else}}
	<p style="position: relative; max-width: 20em; margin: 0 auto 1em auto; line-height: 1.4em;">Confirm email notifications about replies on site <b>{{.Site}}</b></p>
	<form id="confirm" method="post">
		<button type="submit" style="font-size: 18px; padding: 0.5em 1.5em; border: 0; border-radius: 0.3em; background-color: #4fbbd6; color: #fff; cursor: pointer;">Confirm subscription</button>
	</form>
	{{- end}}
</div>
<script nonce="{{.Nonce}}">
	// posting in place keeps this tab at one history entry, which is what lets the browser close it.
	// If the post fails, the plain form posts again and shows the error page
	(function () {
		function closeSoon() {
			setTimeout(function () { window.close(); }, 500);
		}
		var form = document.getElementById('confirm');
		if (!form) {
			closeSoon();
			return;
		}
		form.addEventListener('submit', function (e) {
			e.preventDefault();
			form.querySelector('button').disabled = true;
			fetch(window.location.href, {method: 'POST'})
				.then(function (r) {
					if (!r.ok) {
						throw new Error('status ' + r.status);
					}
					return r.text();
				})
				.then(function (html) {
					document.body.innerHTML = new DOMParser().parseFromString(html, 'text/html').body.innerHTML;
					closeSoon();
				})
				.catch(function () {
					form.submit();
				});
		});
	})();
</script>
</body>
</html>
